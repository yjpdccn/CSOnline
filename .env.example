# 复制为 .env.local 后填写。全部可选：不配置时显示英文原标题与原摘要。

# ---- AI 中文摘要（任意 OpenAI 兼容接口）----
# GitHub Models（默认）：在 https://github.com/settings/personal-access-tokens 创建细粒度令牌，勾选 Models: Read
# LLM_API_KEY=github_pat_xxx
# LLM_BASE_URL=https://models.github.ai/inference
# LLM_MODEL=openai/gpt-4.1-mini

# 智谱 GLM（免费模型 glm-4.7-flash）：https://open.bigmodel.cn 创建 API Key
# LLM_API_KEY=xxx.xxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.7-flash

# DeepSeek / 通义千问 / Kimi / OpenAI 同理，填写对应的 Base URL 与模型名
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 每批条数、每次运行最多请求数、请求最小间隔（毫秒）
# LLM_BATCH_SIZE=12
# LLM_MAX_REQUESTS=20
# LLM_MIN_INTERVAL_MS=4500
# LLM_DISABLED=1

# ---- 本地服务器模式 ----
# REFRESH_INTERVAL_HOURS=12
# DISABLE_SCHEDULER=1
# DATA_DIR=./data

# ---- 可选来源 ----
# 自建 RSSHub 地址（微博/X 来源需要，默认关闭）
# RSSHUB_BASE_URL=https://rsshub.example.com
# 提高 GitHub 搜索 API 限额
# GITHUB_TOKEN=
